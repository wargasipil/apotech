# Copy to .env for `docker compose -f docker-compose.prod.yml`. .env is gitignored.
# Generate a strong secret, e.g.:  openssl rand -hex 32
APOTECH_JWT_SECRET=change-me-to-a-long-random-string
APOTECH_DB_PASSWORD=change-me
APOTECH_OWNER_EMAIL=owner@apotech.local
APOTECH_OWNER_PASSWORD=change-me-on-first-login
# Shop timezone for the "today" boundary in dashboards.
APOTECH_TZ=Asia/Jakarta
